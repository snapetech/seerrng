#!/usr/bin/env sh
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
APP_DIR="$HERE/usr/lib/seerrng"
export NODE_ENV=production
export CONFIG_DIRECTORY="${CONFIG_DIRECTORY:-${XDG_CONFIG_HOME:-$HOME/.config}/seerrng}"
export PORT="${PORT:-5055}"
# The GNU SWC binary is omitted to preserve the AppImage glibc baseline. Use
# the checksum-pinned WASM package embedded by the release workflow instead of
# letting Next.js try to download a native package at startup.
export NEXT_TEST_WASM=1
export NEXT_TEST_WASM_DIR="$APP_DIR/node_modules/next/wasm/@next/swc-wasm-nodejs"
mkdir -p "$CONFIG_DIRECTORY"
cd "$APP_DIR"

if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || ! command -v xdg-open >/dev/null 2>&1; then
  exec "$HERE/usr/bin/node" "$APP_DIR/dist/index.js" "$@"
fi

"$HERE/usr/bin/node" "$APP_DIR/dist/index.js" "$@" &
server_pid=$!
cleanup() {
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

attempt=0
while [ "$attempt" -lt 60 ]; do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid"
  fi

  if "$HERE/usr/bin/node" -e '
    fetch(process.argv[1], { signal: AbortSignal.timeout(1000) })
      .then(() => process.exit(0), () => process.exit(1));
  ' "http://127.0.0.1:${PORT}/api/v1/settings/public" >/dev/null 2>&1; then
    xdg-open "http://127.0.0.1:${PORT}/" >/dev/null 2>&1 || true
    break
  fi

  attempt=$((attempt + 1))
  sleep 0.5
done

wait "$server_pid"
